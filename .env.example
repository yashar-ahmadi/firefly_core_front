# Firefly storefront: runtime configuration. Copy to .env (local) or set in the container.
# پیکربندی زمان اجرای فروشگاه. این فایل را به .env کپی کنید یا در کانتینر تنظیم کنید.
#
# All values are read at runtime, never at build time: one image serves every shop on the same API.
# The one exception: pass FIREFLY_API_URL to `docker build` too (--build-arg), because the next/image
# host allow-list is fixed at build time. See docs/DEPLOYMENT.md and docs/CUSTOMIZATION.md.
# Hex colours are validated as #RRGGBB. In a .env file quote them ("#4F46E5"), because an
# unquoted # starts a comment and the value would silently be empty.
# In development (NODE_ENV is not "production") a missing FIREFLY_API_URL and SITE_URL fall back
# to http://localhost:8000 and http://localhost:3000, and FIREFLY_API_KEY may be empty.
# In production those three are required and the app fails with a list of every invalid variable.

# --- Required in production / الزامی در محیط تولید ---

# آدرس API سرور فایرفلای (بدون اسلش پایانی).
# Base URL of the Firefly Core API (a trailing slash is removed).
FIREFLY_API_URL=http://localhost:8000

# کلید API سمت سرور؛ هرگز با پیشوند NEXT_PUBLIC_ تنظیم نشود.
# Server-side API key; never expose it with a NEXT_PUBLIC_ prefix.
FIREFLY_API_KEY=

# آدرس عمومی همین فروشگاه، برای canonical، سایت‌مپ و کوکی Secure.
# Public URL of this storefront, used for canonical links, the sitemap and Secure cookies.
SITE_URL=http://localhost:3000

# --- Look and feel / ظاهر فروشگاه ---

# نوع فروشگاه: default، digital، agro، boardgame، carpet یا paint (پیش‌فرض: default).
# Shop type preset: default, digital, agro, boardgame, carpet or paint (default: default).
STORE_PRESET=default

# رنگ اصلی برند به‌صورت هگز (اختیاری؛ پیش‌فرض از preset).
# Brand primary colour as hex (optional; defaults to the preset).
# THEME_PRIMARY="#4F46E5"

# رنگ تاکیدی برند به‌صورت هگز (اختیاری؛ پیش‌فرض از preset).
# Brand accent colour as hex (optional; defaults to the preset).
# THEME_ACCENT="#F59E0B"

# گردی گوشه‌ها: sm، md، lg یا xl (اختیاری؛ پیش‌فرض از preset).
# Corner radius scale: sm, md, lg or xl (optional; defaults to the preset).
# THEME_RADIUS=lg

# فونت: vazirmatn (پیش‌فرض) یا custom برای فایل دارای مجوز public/fonts/custom/font.woff2.
# Font: vazirmatn (default) or custom for a licensed variable font at public/fonts/custom/font.woff2.
THEME_FONT=vazirmatn

# --- Map / نقشه ---

# کلید نقشه نشان؛ بدون آن از OpenStreetMap استفاده می‌شود.
# Neshan map key; without it OpenStreetMap is used.
# NESHAN_MAP_KEY=

# کلید سرویس نشان برای جستجو و مکان‌یابی سمت سرور (اختیاری).
# Neshan service key for server-side search and geocoding (optional).
# NESHAN_SERVICE_KEY=

# --- Web push (all five must be set, otherwise push is off) / اعلان وب (هر پنج مورد لازم است) ---

# کلید API وب پروژه Firebase.
# Firebase web API key.
# FIREBASE_API_KEY=

# شناسه پروژه Firebase.
# Firebase project ID.
# FIREBASE_PROJECT_ID=

# شناسه فرستنده پیام Firebase.
# Firebase messaging sender ID.
# FIREBASE_MESSAGING_SENDER_ID=

# شناسه اپلیکیشن وب Firebase.
# Firebase web app ID.
# FIREBASE_APP_ID=

# کلید VAPID برای اعلان وب.
# VAPID key for web push.
# FIREBASE_VAPID_KEY=

# --- Frontend extras (true, false, 1 or 0; default true) / امکانات جانبی ---

# مقایسه محصولات.
# Product comparison.
FEATURE_COMPARE=true

# نمایش سریع محصول.
# Product quick view.
FEATURE_QUICK_VIEW=true

# بازدیدهای اخیر.
# Recently viewed products.
FEATURE_RECENTLY_VIEWED=true

# نصب‌پذیری PWA و سرویس‌ورکر.
# PWA installability and the service worker.
FEATURE_PWA=true

# --- Proxy / پروکسی ---

# هدر حاوی IP کاربر که پروکسی جلوی برنامه تنظیم می‌کند؛ مقدار none یعنی ارسال نشود (پیش‌فرض: x-real-ip).
# Header carrying the client IP set by the reverse proxy; "none" disables forwarding (default: x-real-ip).
CLIENT_IP_HEADER=x-real-ip
