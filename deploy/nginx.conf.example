# Firefly storefront behind nginx: example server block for ONE shop.
# نمونهٔ پیکربندی nginx جلوی فروشگاه؛ برای هر فروشگاه یک server جدا بسازید.
#
# Replace every <...> placeholder. See docs/DEPLOYMENT.md for the full picture (backend settings,
# topologies, health check). Copy into /etc/nginx/conf.d/<shop>.conf and run `nginx -t`.
#
# The storefront container listens on 127.0.0.1:3000 here, e.g.
#   docker run -d --name <shop>-front --env-file /etc/firefly/<shop>.env \
#     -p 127.0.0.1:3000:3000 firefly-front
# Never publish port 3000 on a public interface: the app trusts X-Real-IP from this proxy.
#
# Brotli needs the ngx_brotli module (packaged as libnginx-mod-http-brotli-filter and
# libnginx-mod-http-brotli-static on Debian/Ubuntu). Without it, delete the brotli_* lines:
# nginx -t fails on unknown directives. If the module is dynamic, load it at the top of nginx.conf:
#   load_module modules/ngx_http_brotli_filter_module.so;
#   load_module modules/ngx_http_brotli_static_module.so;

# --- Access log without payment credentials (http level; ONCE per host) ---------------------------
# Some URLs carry a bearer credential (docs/ARCHITECTURE.md, "Payment credentials in URLs"):
# whoever reads one can pay or cancel a guest's order. nginx's usual access log writes each
# request line as it came, so every access_log of the shop below uses `firefly_masked`: the
# request's URI with those parts replaced by <token> / <uuid> ($ff_safe_uri), and no Referer.
# Masked, as pages, as /api/bff/... calls and (single origin) as /api/v1/... calls alike:
#   .../order/pay/<token>/...                 the payment link (its page and its BFF reads, cancel)
#   .../payment/link/<token>/...              the link's payment intent
#   /login/?next=/order/pay/<token>/          the login leading back to it (also %2F-encoded)
#   /api/v1/payment/gateway/callback/<gateway>/<token>/   the bank's return
#   every uuid, two at most: /payment/card-transfer/<uuid>/, /payment/callback/?payment=<uuid>,
#   /api/bff/payment/<uuid>/... (status, cards, receipt, cancel), payment/history/<uuid>/ ...
# A second shop on this host reuses these (nginx refuses a second `log_format` of one name).
# nginx's error log cannot be masked: a request that fails upstream (a 502, a timeout) is written
# there with its request line. Keep that log's access and retention as tight as the
# credentials'. Any other proxy, load balancer or CDN in front must mask the same paths.
map $request_uri $ff_uri_tokens {
    default $request_uri;
    "~*^(?<ff_a>.*/order/pay/)[^/?#]+(?<ff_b>.*)$"                                  "${ff_a}<token>${ff_b}";
    "~*^(?<ff_a>.*/payment/link/)[^/?#]+(?<ff_b>.*)$"                               "${ff_a}<token>${ff_b}";
    "~*^(?<ff_a>.*[?&]next=(?:/|%2F)order(?:/|%2F)pay(?:/|%2F))[^/?&#%]+(?<ff_b>.*)$" "${ff_a}<token>${ff_b}";
    "~*^(?<ff_a>.*/payment/gateway/callback/[^/?#]+/)[^/?#]+(?<ff_b>.*)$"            "${ff_a}<token>${ff_b}";
}
map $ff_uri_tokens $ff_uri_uuid {
    default $ff_uri_tokens;
    "~*^(?<ff_a>.*?)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?<ff_b>.*)$" "${ff_a}<uuid>${ff_b}";
}
map $ff_uri_uuid $ff_safe_uri {
    default $ff_uri_uuid;
    "~*^(?<ff_a>.*?)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?<ff_b>.*)$" "${ff_a}<uuid>${ff_b}";
}
# "combined" without the raw request line and without the Referer (a page's URL can hold one of
# the credentials above; the payment pages send none, but not every client honours that).
log_format firefly_masked '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $ff_safe_uri $server_protocol" $status $body_bytes_sent '
                          '"$http_user_agent"';

# One upstream per shop: a second shop on this host needs its own upstream name and port
# (e.g. `upstream firefly_shop2 { server 127.0.0.1:3001; ... }`), referenced by its server block.
upstream firefly_storefront {
    server 127.0.0.1:3000;
    keepalive 32;
    # nginx 1.15.3+. Must stay below the app's KEEP_ALIVE_TIMEOUT (65 s in the image), so nginx drops an
    # idle connection before Node does; the other way round, nginx can reuse a closed socket (502).
    keepalive_timeout 60s;
}

# Plain HTTP: ACME challenges, then everything to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name <shop.example.ir> www.<shop.example.ir>;
    # An old http:// payment link is logged masked too.
    access_log /var/log/nginx/<shop>.access.log firefly_masked;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://<shop.example.ir>$request_uri;
    }
}

# www → bare domain (SITE_URL, STOREFRONT_URL and SITE_DOMAIN all use the bare domain).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;    # nginx 1.25.1+; older versions: `listen 443 ssl http2;` instead
    server_name www.<shop.example.ir>;
    access_log /var/log/nginx/<shop>.access.log firefly_masked;

    ssl_certificate     /etc/letsencrypt/live/<shop.example.ir>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<shop.example.ir>/privkey.pem;

    return 301 https://<shop.example.ir>$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;    # nginx 1.25.1+; older versions: `listen 443 ssl http2;` instead
    server_name <shop.example.ir>;

    # Every location of the shop logs through the masks above (one that sets its own access_log
    # must name `firefly_masked` too). The health probe below logs nothing.
    access_log /var/log/nginx/<shop>.access.log firefly_masked;

    # --- TLS (placeholders: point at your certificate) -----------------------------------------
    ssl_certificate     /etc/letsencrypt/live/<shop.example.ir>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<shop.example.ir>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:firefly_ssl:10m;
    ssl_session_timeout 1d;

    # HSTS only: the app itself sends X-Frame-Options, CSP frame-ancestors, X-Content-Type-Options
    # and Referrer-Policy on every response (next.config.ts), so they are not repeated here (nginx
    # would send them twice). add_header is not inherited by a location that has its own
    # add_header: repeat this line there.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Receipt (card-to-card) and avatar uploads are up to 5 MB, plus multipart overhead.
    client_max_body_size 6m;

    # --- Compression ------------------------------------------------------------------------------
    # nginx compresses once, with brotli or gzip: Accept-Encoding is cleared towards the app (below),
    # so the app answers with identity bodies. (The app gzips by itself only when no proxy strips
    # that header.) text/x-component is the RSC payload of every client-side navigation.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/x-component application/xml
               application/javascript application/json application/manifest+json image/svg+xml
               font/ttf;

    brotli on;
    brotli_comp_level 5;
    brotli_min_length 1024;
    brotli_types text/plain text/css text/xml text/x-component application/xml
                 application/javascript application/json application/manifest+json image/svg+xml
                 font/ttf;

    # --- Proxy headers ----------------------------------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # The visitor IP. nginx OVERWRITES this header, so a browser cannot forge it: the storefront
    # reads it (CLIENT_IP_HEADER=x-real-ip, the default) and passes it on to the API.
    proxy_set_header X-Real-IP $remote_addr;
    # Appends to whatever the browser sent, so it is spoofable: informational only. Never set
    # CLIENT_IP_HEADER=x-forwarded-for behind this proxy.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # Identity bodies from the app, so the brotli/gzip settings above compress each response once.
    proxy_set_header Accept-Encoding "";
    proxy_read_timeout 60s;

    # Build assets have content hashes in their names: cache them for a year.
    location /_next/static/ {
        proxy_pass http://firefly_storefront;
        proxy_hide_header Cache-Control;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # Health probe for load balancers and monitoring: 200 "ok", or 503 "unhealthy" when the app's
    # environment is invalid; it never calls the API. Note the trailing slash (/healthz without it
    # is a 308 redirect).
    location = /healthz/ {
        proxy_pass http://firefly_storefront;
        access_log off;
    }

    # Optional (recommended): a per-IP rate limit on the catalog pages, so one address cannot spend
    # the storefront's shared anonymous API budget with made-up slugs and queries. Needs, at http
    # level (outside this server block):
    #   limit_req_zone $binary_remote_addr zone=firefly_catalog:10m rate=10r/s;
    # The burst is generous: client navigations and card-link prefetches hit these paths too.
    # location ~ ^/(product|product-category|brand|categories|search)/ {
    #     limit_req zone=firefly_catalog burst=60 nodelay;
    #     limit_req_status 429;
    #     proxy_pass http://firefly_storefront;
    #     proxy_buffering off;
    # }

    # Everything else: pages, /api/bff/ (the BFF), robots.txt, /s/<code> short links, and the paths
    # the storefront forwards to the API itself (/media/, /static/, /sitemap.xml and the bank
    # callback /api/v1/payment/gateway/callback/...). Methods, bodies and the trailing slash are
    # kept as they are.
    location / {
        proxy_pass http://firefly_storefront;
        # Pages stream (React Suspense): pass chunks on as they come.
        proxy_buffering off;
    }

    # Single-origin topology only (Django is served from this same host, FIREFLY_API_URL is
    # https://<shop.example.ir>): /api/v1/, /media/, /static/, /sitemap.xml and the panel must
    # then go to Django HERE, before `location /`, or the storefront would forward them back to
    # itself. The full server block is in docs/DEPLOYMENT.md (single origin).
}
