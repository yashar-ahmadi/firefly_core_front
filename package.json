{
  "name": "firefly-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && node scripts/check-build-context.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:journeys": "playwright test --project=journeys --no-deps",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@neshan-maps-platform/leaflet": "1.0.8",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "firebase": "12.19.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "next": "16.4.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "fontkit": "2.0.4",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@firebase/util",
      "protobufjs",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    },
    "overrides": {
      "@neshan-maps-platform/leaflet>html-webpack-plugin": "-",
      "@neshan-maps-platform/leaflet>leaflet": "-",
      "@neshan-maps-platform/leaflet>ol": "-",
      "@neshan-maps-platform/leaflet>pako": "-",
      "@neshan-maps-platform/leaflet>pbf": "-"
    }
  }
}
